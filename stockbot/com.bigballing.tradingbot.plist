<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bigballing.tradingbot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rudragandhi/Documents/bigballing/run_forever.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rudragandhi/Documents/bigballing</string>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the supervisor only if it exits abnormally. A clean exit (code 0),
         which run_forever.sh uses for a breaker HALT or a manual stop, is left
         stopped so a halt stays halted until you relaunch. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rudragandhi/Documents/bigballing/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/rudragandhi/Documents/bigballing/logs/launchd.err</string>
</dict>
</plist>
